# Written by the installing agent; owners change settings by talking to the bot (projects/<slug>/settings.json, data/settings.json).

# Token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Only whoever opens t.me/<bot>?start=<code> becomes the owner.
# Empty: the owner is confirmed on this computer instead (node bot/claim.mjs).
OWNER_CODE=

# Which coding agent drives the bot: claude | codex.
AGENT=claude
# Full path to its CLI if it is not on PATH for the service.
AGENT_BIN=
# Optional model override, e.g. opus or gpt-5.
AGENT_MODEL=

# Language of the bot's own short messages: ru | en.
BOT_LANG=ru
# The agent session is rotated (after a handoff note) between iterations: past the soft
# token limit once the prompt cache has gone cold (no turn for SESSION_CACHE_MINUTES),
# past the hard limit, the turn count or the idle hours always.
SESSION_MAX_TOKENS=150000
SESSION_HARD_TOKENS=500000
SESSION_CACHE_MINUTES=60
SESSION_MAX_TURNS=40
SESSION_IDLE_HOURS=12

# Local speech-to-text model for voice notes: tiny | base | small | medium.
STT_MODEL=small
